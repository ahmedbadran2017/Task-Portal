{
  "name": "Justyol Task Hub",
  "short_name": "Task Hub",
  "description": "Cross-department task & issue management for Justyol",
  "id": "/taskhub",
  "start_url": "/taskhub/dashboard",
  "scope": "/taskhub",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f5f4",
  "theme_color": "#fafaf9",
  "icons": [
    {
      "src": "/assets/task_hub/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/task_hub/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/task_hub/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Ticket",
      "url": "/taskhub/board?new=1",
      "icons": [{ "src": "/assets/task_hub/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Tickets",
      "url": "/taskhub/tickets?mine=1",
      "icons": [{ "src": "/assets/task_hub/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
